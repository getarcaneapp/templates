{
  "name": "arcane-templates",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "lint": "vp run type-check && vp run generate && vp run format:check && vp run validate",
    "type-check": "tsc --noEmit && pnpm --filter @arcane-templates/site check",
    "test": "vp test",
    "validate": "tsx scripts/lint-templates.ts",
    "generate": "tsx scripts/build-registry.ts",
    "ci": "vp run lint && vp run test && vp run generate",
    "stage": "rm -rf build && vp run build:site && cp registry.json schema.json build/ && cp -R templates/. build/templates/",
    "deploy": "vp run stage && wrangler version deploy",
    "dev": "pnpm --filter @arcane-templates/site dev",
    "prepare": "vp config",
    "snyk": "snyk test --all-projects --dev",
    "lint:templates": "tsx scripts/lint-templates.ts",
    "build:site": "pnpm --filter @arcane-templates/site build",
    "dev:worker": "vp run generate && vp run stage && wrangler dev",
    "new": "tsx scripts/new-template.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.8.2+sha512.a5941679663d952c5f0ecc38ba98af98b4dc01b95780354f6894f2f873973cef2f7e2989d7db3ee5393938ae21f62fe06bcdf685d475ddad829a62095d2b8b11"
}
