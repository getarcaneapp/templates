# Admin password, 12 or more characters. Set it before the first start so the
# setup page is never open to others on your network. Homedex stores only its
# Argon2id hash on the first start and ignores the value once an admin exists.
# Leave it empty only if the UI stays on loopback and you finish setup yourself.
HOMEDEX_ADMIN_PASSWORD=

# Address the web UI is published on. 127.0.0.1 keeps it on this host; set
# 0.0.0.0 to open it to your LAN, and set HOMEDEX_ADMIN_PASSWORD with it.
HOMEDEX_BIND=127.0.0.1
HOMEDEX_PORT=7377

# Image tag. 0.2 follows the newest 0.2.x release.
HOMEDEX_VERSION=0.2.3

# true only when Homedex is always reached over HTTPS through a reverse proxy.
HOMEDEX_SECURE_COOKIES=false
